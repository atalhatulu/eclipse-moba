script = ExtResource("4_ixutg")
id = "solen_passive"
ability_name = "Güneş Yükü (Solar Charge)"
slot = 0
target_type = 4
target_filter = 6
is_passive = true
description = "Solen'in her normal saldırısı 1 Güneş Yükü biriktirir. 5. vuruşta yükler patlayarak hedefe ilave 60/100/140/180 saf güneş hasarı verir ve %40 Zırh Deler."

[sub_resource type="Resource" id="Resource_o4oig"]
script = ExtResource("4_ixutg")
id = "solen_q"
ability_name = "Delici Güneş Oku (Piercing Arrow)"
target_type = 2
description = "Hedef doğrultuya 13 metre boyunca tüm düşman ve minyonları delip geçen yoğunlaştırılmış bir güneş oku fırlatır. Delinen her hedefe fiziksel hasar uygular."
